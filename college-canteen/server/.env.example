# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/college_canteen

# For MongoDB Atlas (cloud), replace the above with:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college_canteen?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Replace this with a long random string before production!
# You can generate one by running: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_string_before_using_in_production
JWT_EXPIRES_IN=7d

# Cookie Settings
COOKIE_SECRET=change_this_cookie_secret_too

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (used by seed script only)
# Change these immediately after first login!
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@canteen.com
ADMIN_PASSWORD=Admin@123456
